{
  "name": "ope-term",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.0",
  "description": "A route-first SSH terminal for operators and developers.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hjosugi/ope-term.git"
  },
  "homepage": "https://github.com/hjosugi/ope-term#readme",
  "bugs": "https://github.com/hjosugi/ope-term/issues",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run typecheck && vite build",
    "performance:fixture": "node scripts/performance-fixture.mjs",
    "performance:gate": "node scripts/performance-gate.mjs",
    "security:policy": "node scripts/security-policy.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "graphify:setup": "sh scripts/graphify.sh setup",
    "graphify:update": "sh scripts/graphify.sh update"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
